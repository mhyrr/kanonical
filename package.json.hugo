{
  "name": "kanonical-hugo",
  "private": true,
  "description": "Kanonical - Greg's corner of the internet",
  "version": "1.0.0",
  "scripts": {
    "dev": "hugo server --buildDrafts",
    "build": "hugo --minify",
    "tailwind:watch": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0"
  }
}
